// HTTP-сервис "InventoryAPI" (inventory_api)
// Корневой URL: /inventory_api
// 
// Шаблоны:
// 1. /os/search - GET - Поиск основного средства
// 2. /inventory/list - GET - Список документов "Инвентаризация ОС"
// 3. /inventory/sync - POST - Отправка фактических данных по инвентаризации

// -----------------------------------------------------------------------------
// 1. Поиск основного средства по штрихкоду, инвентарному или серийному номеру
// Шаблон: /os/search?q={query}
// Метод: GET
// -----------------------------------------------------------------------------
Функция ossearchGET(Запрос)
	
	СтрокаПоиска = Запрос.ПараметрыЗапроса.Получить("q");
	
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки(СоздатьJSON(Новый Структура("error", "Не указан параметр q")));
		Возврат Ответ;
	КонецЕсли;

	Запрос1С = Новый Запрос;
	Запрос1С.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.Ссылка КАК ОС,
		|	ОсновныеСредства.Наименование КАК Наименование,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ЕСТЬNULL(МестонахождениеОССрезПоследних.МОЛ.Наименование, """") КАК МОЛ,
		|	ЕСТЬNULL(МестонахождениеОССрезПоследних.Подразделение.Наименование, """") КАК Подразделение,
		|	ЕСТЬNULL(СостоянияОССрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)) КАК Состояние
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестонахождениеОС.СрезПоследних КАК МестонахождениеОССрезПоследних
		|		ПО ОсновныеСредства.Ссылка = МестонахождениеОССрезПоследних.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОС.СрезПоследних КАК СостоянияОССрезПоследних
		|		ПО ОсновныеСредства.Ссылка = СостоянияОССрезПоследних.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ПО ОсновныеСредства.Ссылка = Штрихкоды.Владелец
		|ГДЕ
		|	(ОсновныеСредства.ИнвентарныйНомер ПОДОБНО &СтрокаПоиска
		|			ИЛИ ОсновныеСредства.ЗаводскойНомер ПОДОБНО &СтрокаПоиска
		|			ИЛИ Штрихкоды.Штрихкод = &ТочнаяСтрокаПоиска)";
	
	Запрос1С.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
	Запрос1С.УстановитьПараметр("ТочнаяСтрокаПоиска", СтрокаПоиска);
	
	Результат = Запрос1С.Выполнить();
	Если Результат.Пустой() Тогда
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки(СоздатьJSON(Новый Структура("error", "ОС не найдено")));
		Возврат Ответ;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ДанныеОС = Новый Структура;
	ДанныеОС.Вставить("id", Строка(Выборка.ОС.УникальныйИдентификатор()));
	ДанныеОС.Вставить("name", Выборка.Наименование);
	ДанныеОС.Вставить("inventoryNumber", Выборка.ИнвентарныйНомер);
	ДанныеОС.Вставить("mol", Выборка.МОЛ);
	ДанныеОС.Вставить("department", Выборка.Подразделение);
	ДанныеОС.Вставить("status", Строка(Выборка.Состояние));
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СоздатьJSON(ДанныеОС));
	
	Возврат Ответ;

КонецФункции

// -----------------------------------------------------------------------------
// 2. Получение списка документов "Инвентаризация ОС"
// Шаблон: /inventory/list
// Метод: GET
// -----------------------------------------------------------------------------
Функция inventorylistGET(Запрос)
	
	Запрос1С = Новый Запрос;
	// Выбираем непроведенные (или в статусе "В работе", если применимо) документы
	Запрос1С.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнвентаризацияОС.Ссылка КАК Документ,
		|	ИнвентаризацияОС.Номер КАК Номер,
		|	ИнвентаризацияОС.Дата КАК Дата,
		|	ИнвентаризацияОС.Подразделение.Наименование КАК Подразделение,
		|	ИнвентаризацияОС.МОЛ.Наименование КАК МОЛ
		|ИЗ
		|	Документ.ИнвентаризацияОС КАК ИнвентаризацияОС
		|ГДЕ
		|	ИнвентаризацияОС.ПометкаУдаления = ЛОЖЬ
		|	И ИнвентаризацияОС.Проведен = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
	Выборка = Запрос1С.Выполнить().Выбрать();
	МассивДокументов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СтруктДок = Новый Структура;
		СтруктДок.Вставить("id", Строка(Выборка.Документ.УникальныйИдентификатор()));
		СтруктДок.Вставить("number", Выборка.Номер);
		СтруктДок.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		СтруктДок.Вставить("department", Выборка.Подразделение);
		СтруктДок.Вставить("mol", Выборка.МОЛ);
		
		// Получим плановый состав
		ЗапросОС = Новый Запрос;
		ЗапросОС.Текст = 
			"ВЫБРАТЬ
			|	ИнвентаризацияОСОС.ОсновноеСредство КАК ОС,
			|	ИнвентаризацияОСОС.ОсновноеСредство.Наименование КАК Наименование,
			|	ИнвентаризацияОСОС.ОсновноеСредство.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ЕСТЬNULL(Штрихкоды.Штрихкод, """") КАК Штрихкод,
			|	ИнвентаризацияОСОС.НаличиеПоДаннымУчета КАК ПоПлану
			|ИЗ
			|	Документ.ИнвентаризацияОС.ОС КАК ИнвентаризацияОСОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
			|		ПО ИнвентаризацияОСОС.ОсновноеСредство = Штрихкоды.Владелец
			|ГДЕ
			|	ИнвентаризацияОСОС.Ссылка = &Документ";
		ЗапросОС.УстановитьПараметр("Документ", Выборка.Документ);
		
		ВыборкаОС = ЗапросОС.Выполнить().Выбрать();
		МассивОС = Новый Массив;
		Пока ВыборкаОС.Следующий() Цикл
			СтруктОС = Новый Структура;
			СтруктОС.Вставить("id", Строка(ВыборкаОС.ОС.УникальныйИдентификатор()));
			СтруктОС.Вставить("name", ВыборкаОС.Наименование);
			СтруктОС.Вставить("inventoryNumber", ВыборкаОС.ИнвентарныйНомер);
			СтруктОС.Вставить("barcode", ВыборкаОС.Штрихкод);
			СтруктОС.Вставить("planned", ВыборкаОС.ПоПлану);
			МассивОС.Добавить(СтруктОС);
		КонецЦикла;
		
		СтруктДок.Вставить("items", МассивОС);
		МассивДокументов.Добавить(СтруктДок);
	КонецЦикла;
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СоздатьJSON(МассивДокументов));
	
	Возврат Ответ;
	
КонецФункции

// -----------------------------------------------------------------------------
// 3. Синхронизация факта по инвентаризации
// Шаблон: /inventory/sync
// Метод: POST
// -----------------------------------------------------------------------------
Функция inventorysyncPOST(Запрос)
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(Чтение);
	
	// Ожидаемый формат:
	// { "documentId": "guid", "scannedItems": [ { "id": "guid_os", "barcode": "..." }, ... ] }
	
	ИДДокумента = Данные.documentId;
	СсылкаДок = Документы.ИнвентаризацияОС.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента));
	
	Если СсылкаДок.Пустая() Тогда
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки(СоздатьJSON(Новый Структура("error", "Документ не найден")));
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		ОбъектДок = СсылкаДок.ПолучитьОбъект();
		// Очищаем фактические данные перед заполнением
		Для Каждого СтрокаОС Из ОбъектДок.ОС Цикл
			СтрокаОС.НаличиеФактическое = Ложь;
		КонецЦикла;
		
		Для Каждого СканОС Из Данные.scannedItems Цикл
			УИД_ОС = Новый УникальныйИдентификатор(СканОС.id);
			СсылкаОС = Справочники.ОсновныеСредства.ПолучитьСсылку(УИД_ОС);
			
			Если Не СсылкаОС.Пустая() Тогда
				СтрокаТабличнойЧасти = ОбъектДок.ОС.Найти(СсылкаОС, "ОсновноеСредство");
				Если СтрокаТабличнойЧасти = Неопределено Тогда
					// Излишек (ОС нет по учету в этом документе, но мы его нашли)
					НоваяСтрока = ОбъектДок.ОС.Добавить();
					НоваяСтрока.ОсновноеСредство = СсылкаОС;
					НоваяСтрока.НаличиеПоДаннымУчета = Ложь;
					НоваяСтрока.НаличиеФактическое = Истина;
				Иначе
					// Найдено по плану
					СтрокаТабличнойЧасти.НаличиеФактическое = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ОбъектДок.Записать(РежимЗаписиДокумента.Запись);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(СоздатьJSON(Новый Структура("success", Истина)));
		Возврат Ответ;
		
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки(СоздатьJSON(Новый Структура("error", ОписаниеОшибки())));
		Возврат Ответ;
	КонецПопытки;
	
КонецФункции

// Вспомогательная функция для сериализации в JSON
Функция СоздатьJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	ЗаписатьJSON(ЗаписьJSON, Данные, НастройкиСериализации);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции
